services:
  nginx:
    ports:
      - '${APP_NGINX_PORT:-80}:80'
    volumes:
      - ./docker/nginx/prod/nginx.conf:/etc/nginx/conf.d/default.conf
      - ./:/var/www:cached
    restart: always

  php:
    build:
      args:
        UID: 1000
        GID: 1000

  postgres:
    ports:
      - '${APP_POSTGRES_PORT}:5432'
    environment:
      POSTGRES_DB: ${DB_DATABASE}
      POSTGRES_USER: ${DB_USERNAME}
      POSTGRES_PASSWORD: ${DB_PASSWORD}
    restart: always